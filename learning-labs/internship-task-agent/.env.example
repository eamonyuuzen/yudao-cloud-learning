# Yudao Gateway 的 admin-api 根路径
YUDAO_BASE_URL=http://localhost:48080/admin-api
YUDAO_TIMEOUT_SECONDS=10
AGENT_RUN_TIMEOUT_SECONDS=45

# 必须使用支持 Tool Calling 的模型。
MODEL_NAME=
MODEL_API_KEY=

# OpenAI 官方地址可留空；OpenAI-compatible Provider 填其 Base URL。
MODEL_BASE_URL=

# 非官方 Provider 或本地实验可关闭 SDK 云端 tracing；
# 即使以后开启，代码也固定不把敏感输入输出写入 SDK tracing；
# 本项目仍会返回自己的脱敏 tool trace。
DISABLE_SDK_TRACING=true
